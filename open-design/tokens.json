{
  "paper": {
    "bg": "#FFFBF0",
    "gridDot": "rgba(34,34,34,0.08)",
    "textureOpacity": 0.04
  },
  "pencil": {
    "palette": {
      "red": "#F38181",
      "yellow": "#FFD93D",
      "mint": "#4ECDC4",
      "blue": "#95E1D3",
      "pink": "#FF6B9D",
      "black": "#111111"
    },
    "cardFillOpacity": 0.14,
    "hatchPattern": "diagonal-2px"
  },
  "card": {
    "radiusHandDrawn": "14px 18px 16px 12px",
    "radiusHover": "16px 14px 18px 16px",
    "borderIdle": "2px dashed #222222",
    "borderHover": "2.5px solid #111111",
    "shadow": "2px 3px 0 #111111",
    "shadowHover": "3px 4px 0 #111111",
    "padding": "20px",
    "gap": "16px"
  },
  "hover": {
    "wobble": {
      "duration": "0.6s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "keyframes": "rotate(-0.4deg) translate(0.5px,0.3px) rotate(0.4deg) -> rotate(0.4deg) translate(-0.5px,-0.2px) rotate(-0.4deg)"
    },
    "liveliness": {
      "strokeDasharray": 1000,
      "strokeDashOffsetDuration": "0.9s",
      "turbulenceBaseFrequency": "0.015 -> 0.022 (anim 2.5s)",
      "filter": "url(#pencil-rough)"
    },
    "transition": "all 180ms ease-out"
  },
  "typography": {
    "heading": "Caveat, Patrick Hand, cursive",
    "headingWeight": 600,
    "body": "Inter, system-ui, sans-serif",
    "accent": "Patrick Hand, cursive",
    "heroSize": "48px / 56px",
    "cardTitle": "18px / 600",
    "cardBody": "14px / 400"
  },
  "animation": {
    "paperFloat": "float 6s ease-in-out infinite",
    "stickerPop": "pop 320ms cubic-bezier(0.34,1.56,0.64,1)"
  }
}
